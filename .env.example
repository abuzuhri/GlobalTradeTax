TRADE_API_KEY=replace-with-a-long-random-secret
TRADE_TENANT_ID=demo-merchant
# Process-local authenticated merchant request budget (see docs/TENANT_RATE_LIMITS.md).
TenantRateLimit__PermitLimit=120
TenantRateLimit__WindowSeconds=60
TenantRateLimit__MaxTenants=10000
# Operator-only staging API; use a separate randomly generated 32+ character secret.
TRADE_OPERATOR_KEY=replace-with-32-plus-random-characters
# Optional public UK read-only reference API.
# TRADE_UK_TARIFF_API_BASE_URL=https://www.trade-tariff.service.gov.uk/uk/api/v2/
# Northern Ireland is a separate optional prefix; it never falls back to GB.
# TRADE_UK_TARIFF_XI_API_BASE_URL=https://www.trade-tariff.service.gov.uk/xi/api/v2/
# Managed alternative: provision real credentials through your secret provider, never in this file.
# TRADE_UK_TARIFF_API_BASE_URL=https://api.trade-tariff.service.gov.uk/uk/api/
# TRADE_UK_TARIFF_XI_API_BASE_URL=https://api.trade-tariff.service.gov.uk/xi/api/
# TRADE_UK_TARIFF_CLIENT_ID=replace-with-developer-portal-client-id
# TRADE_UK_TARIFF_CLIENT_SECRET=replace-through-your-secret-provider
# Review-only Saleor payload import; configure trusted store/key separately (see docs/SALEOR_REVIEW_PILOT.md).
Saleor__ReviewEnabled=false
